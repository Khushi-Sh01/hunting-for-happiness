# Default partner demo: real MongoDB Atlas. Never commit .env.
STORAGE_MODE=mongo
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=hunting_for_happiness
# Local Ollama, or the private hostname of your hosted Ollama service.
OLLAMA_URL=http://127.0.0.1:11434
GEMMA_MODEL=gemma3:4b
# Alternate local/offline profile: set STORAGE_MODE=sqlite.
SQLITE_PATH=data/happiness.sqlite3
STORE_REFLECTIONS=false
ENABLE_VOICE=false
WHISPER_MODEL=tiny.en
WHISPER_OFFLINE=false
